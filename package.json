{
  "name": "mingeagle-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/patch-discovery-school.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "cf:dev": "wrangler pages dev dist",
    "cf:deploy:scheduler": "wrangler deploy --config wrangler.scheduler.toml",
    "db:migrate:local": "wrangler d1 migrations apply MINGEAGLE_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply MINGEAGLE_DB --remote",
    "test:discovery": "node scripts/test-discovery.mjs && node scripts/test-discovery-sources.mjs && node scripts/test-discovery-quality.mjs && node scripts/test-discovery-auto.mjs && node scripts/test-discovery-runner.mjs && node scripts/test-communications.mjs && node scripts/test-admin-reads.mjs && node scripts/test-scheduler-heartbeat.mjs && node scripts/test-discovery-diagnostics.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "esbuild": "^0.28.2",
    "typescript": "latest",
    "wrangler": "latest"
  }
}
